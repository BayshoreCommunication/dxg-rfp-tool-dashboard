# Customer Dashboard
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-long-random-authjs-secret

# Must exactly match the backend BFF_SHARED_SECRET. Never expose this through a
# NEXT_PUBLIC_ variable.
BFF_SHARED_SECRET=replace-with-the-same-long-random-secret-used-by-the-backend

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Review-first room specification recommendations on the Room Specifications
# step. Requires the backend ROOM_RECOMMENDATIONS_ENABLED flag as well.
NEXT_PUBLIC_ROOM_RECOMMENDATIONS_ENABLED=false

# Offers "Use what I've told you", which turns typed messages into a source and
# extracts requirements from them. Requires the backend
# CONVERSATION_EXTRACTION_ENABLED flag; while that gate is closed the task is
# shown disabled with the reason rather than failing on click.
NEXT_PUBLIC_CONVERSATION_EXTRACTION_ENABLED=false
